# RAK 4 CREATIVE Traffic Management - Email Notification Configuration

# Runtime (cPanel normally assigns PORT automatically)
NODE_ENV=production
PORT=3000
APP_URL=https://traffic.example.com

# Protects /api/email/daily-cron. Generate a long random value and use the
# same value in the Authorization header of the cPanel cron command.
CRON_SECRET=replace_with_a_long_random_secret

# Provider Options: 'simulated' | 'resend' | 'sendgrid' | 'brevo' | 'webhook'
EMAIL_PROVIDER=simulated

# Optional comma-separated allowlist for live delivery, e.g.
# EMAIL_ALLOWED_DOMAINS=rak4creative.com,gmail.com
EMAIL_ALLOWED_DOMAINS=rak4creative.com

# Sender Details
EMAIL_FROM_NAME="RAK 4 CREATIVE Traffic Operations"
EMAIL_FROM="traffic@rak4creative.com"
EMAIL_REPLY_TO="farah.y@rak4creative.com"

# Provider API Keys (Fill the one you use)
# 1. Resend (https://resend.com)
RESEND_API_KEY=

# 2. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=

# 3. Brevo / Sendinblue (https://brevo.com)
BREVO_API_KEY=

# 4. Custom Webhook Endpoint
EMAIL_WEBHOOK_URL=
