# RAK 4 CREATIVE Traffic Management - Email Notification Configuration

# Provider Options: 'simulated' | 'resend' | 'sendgrid' | 'brevo' | 'webhook'
EMAIL_PROVIDER=simulated

# Sender Details
EMAIL_FROM_NAME="RAK 4 CREATIVE Traffic Operations"
EMAIL_FROM="traffic@rak4creative.com"
EMAIL_REPLY_TO="farah.y@rak4creative.com"

# Provider API Keys (Fill the one you use)
# 1. Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# 2. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=SG.your_api_key_here

# 3. Brevo / Sendinblue (https://brevo.com)
BREVO_API_KEY=xkeysib-your_api_key_here

# 4. Custom Webhook Endpoint
EMAIL_WEBHOOK_URL=https://your-webhook-endpoint.com/api/emails
